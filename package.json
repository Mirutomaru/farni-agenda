{
  "name": "farni-agenda",
  "version": "2.0.0",
  "description": "Informační systém pro Starokatolickou církev - správa agendy osob, majetku a financí",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:unit": "jest tests/backend/unit --coverage=false",
    "test:integration": "jest tests/backend/integration --coverage=false",
    "test:components": "jest tests/frontend/components --coverage=false",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "test:all": "./run-tests.sh",
    "test:watch": "jest --watch",
    "test:debug": "jest --verbose --no-coverage --runInBand"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "jspdf": "^2.5.1",
    "next": "^16.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
