# FARNÍ AGENDA - Environmentální proměnné

# ⚠️ DŮLEŽITÉ: Nikdy nekomitujte tento soubor do Gitu!
# Přidejte .env.local do .gitignore

# ============================================================================
# SUPABASE KONFIGURACE
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://vas-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=vas-anon-key-zde
SUPABASE_SERVICE_ROLE_KEY=vas-service-role-key-zde

# ============================================================================
# GOOGLE OAUTH 2.0 (pro Supabase Auth)
# ============================================================================

GOOGLE_CLIENT_ID=vas-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=vas-client-secret-zde

# Po registraci v Google Cloud Console:
# 1. Jděte na https://console.cloud.google.com/
# 2. Vytvořte nový projekt nebo vyberte existující
# 3. OAuth consent screen - nastavit jako "External"
# 4. Credentials - Create Credentials -> OAuth Client ID
# 5. Application type: Web application
# 6. Authorized redirect URIs: https://vas-projekt.supabase.co/auth/v1/callback

# ============================================================================
# SMARTFORM.CZ (Český našeptávač adres - RÚIAN)
# ============================================================================

SMARTFORM_API_KEY=vas-smartform-api-key-zde

# Registrace na Smartform.cz:
# 1. Jděte na https://smartform.cz/
# 2. Založte účet a získáte API key
# 3. Klíč použijte v .env.local

# ============================================================================
# E-MAILOVÉ API (SendGrid nebo Resend)
# ============================================================================

# Volba SendGrid:
SENDGRID_API_KEY=vas-sendgrid-key-zde

# Nebo Resend (alternativa):
RESEND_API_KEY=vas-resend-key-zde

# SendGrid registrace: https://sendgrid.com/
# Resend registrace: https://resend.com/

# ============================================================================
# ŠIFROVÁNÍ DAT (AES-256-CBC)
# ============================================================================

ENCRYPTION_KEY=vase-slovo-pro-šifrovani-min-32-charakteru-dlouhe

# GENEROVÁNÍ BEZPEČNÉHO KLÍČE:
# openssl rand -hex 32

# Doporučení:
# - Minimálně 32 znaků
# - Obsahovat velká/malá písmena, čísla, speciální znaky
# - Uložit na bezpečné místo (password manager)

# ============================================================================
# GOOGLE CLOUD STORAGE (pro týdenní backupy)
# ============================================================================

GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...", ...}'
GCS_BUCKET_NAME=farni-agenda-backups

# Nastavení GCP:
# 1. Jděte na https://console.cloud.google.com/
# 2. Vytvořte nový projekt nebo vyberte existující
# 3. IAM & Admin -> Service Accounts -> Create Service Account
# 4. Role: Storage Admin
# 5. Keys -> Add Key -> Create new key (JSON)
# 6. Zkopírujte celý JSON do GCP_SERVICE_ACCOUNT_KEY

# Vytvoření bucketu:
# gsutil mb -p vas-project-id gs://farni-agenda-backups

# ============================================================================
# DALŠÍ KONFIGURACE
# ============================================================================

# Next.js
NEXT_PUBLIC_APP_NAME="Farní Agenda"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port pro lokální vývoj
PORT=3000

# Logování
NODE_ENV=development

# ============================================================================
# PRODUKČNÍ PROMĚNNÉ (Vercel/Supabase Dashboard)
# ============================================================================

# V produkci nastavte tyto proměnné v:
# 1. Vercel Dashboard -> Project Settings -> Environment Variables
# 2. Supabase Dashboard -> Settings -> API

# Důležité pro Edge Functions:
SUPABASE_URL=https://vas-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=vas-service-role-key-zde
SENDGRID_API_KEY=vas-sendgrid-key-zde
RESEND_API_KEY=vas-resend-key-zde
GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
GCS_BUCKET_NAME=farni-agenda-backups
