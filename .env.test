// FARNÍ AGENDA - TESTOVACÍ ENVIRONMENT PROMĚNNÉ
# .env.test soubor pro testování

# Supabase Test Configuration
NEXT_PUBLIC_SUPABASE_URL=https://test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key-here

# Google OAuth Test
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-client-secret-here

# Smartform Test API Key (nebo mock)
SMARTFORM_API_KEY=test-smartform-api-key

# E-mailové API pro testy (SendGrid/Resend)
SENDGRID_API_KEY=test-sendgrid-api-key
RESEND_API_KEY=

# Šifrovací klíč pro testy
ENCRYPTION_KEY=test-encryption-key-32-characters-here!

# Google Cloud Storage Test
GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"test-project"}'
GCS_BUCKET_NAME=farni-agenda-test-backups

# Testovací URL
APP_URL=http://localhost:3000

# Mock Data
MOCK_DATA_ENABLED=true
MOCK_DATABASE_URL=postgresql://test:test@localhost:5432/farni_agenda_test

# Rate Limiting pro testy (disable)
RATE_LIMIT_ENABLED=false

# Feature Flags pro testování
FEATURE_CERTIFICATES_ENABLED=true
FEATURE_STATISTICS_ENABLED=true
FEATURE_BIRTHDAY_WATCHER_ENABLED=true
